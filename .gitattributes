* text=auto
*.md text eol=lf
*.ini text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
# Unreal packages: binary, non-mergeable, lockable with a supporting LFS server
*.[uU][aA][sS][sS][eE][tT] filter=lfs diff=lfs merge=lfs -text lockable
*.[uU][mM][aA][pP] filter=lfs diff=lfs merge=lfs -text lockable
